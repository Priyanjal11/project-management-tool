# GEMINI_API_KEY: Required for Gemini AI API calls (Google Search Grounding).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Relational JDBC Configuration (for /java-backend deployment):
PMT_JDBC_URL="jdbc:postgresql://localhost:5432/pmt_db"
PMT_JDBC_USER="pmt_app_user"
PMT_JDBC_PASSWORD="YOUR_DB_PASSWORD"
